# SmartStudy AI Environment Configuration
# Copy this file to .env and configure your variables

# Google Gemini API Key for AI features (Get one at https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_api_key_here

# App Secret Key for session security (optional override)
SECRET_KEY=smartstudy-secret-key-change-in-production

# Database URI (defaults to SQLite in data/smartstudy.db)
DATABASE_URL=sqlite:///data/smartstudy.db
